PREFIX : <http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#>

SELECT DISTINCT ?drugEffect ?secondaryEffect WHERE{
    :Statin_instance :perturbs_mechanistically ?target .
    ?target :resolves_to+ ?drugEffect .
    
    ?drugEffect (:System_Event_Logic|:Genetic_Logic|:switches_off|:switches_on)* ?mid .
    ?mid :resolves_to+ ?secondaryEffect .
    
}
