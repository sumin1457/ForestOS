{\rtf1\ansi\ansicpg1252\cocoartf2759
\cocoatextscaling0\cocoaplatform0{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;}
{\*\expandedcolortbl;;}
\paperw11900\paperh16840\margl1440\margr1440\vieww11520\viewh8400\viewkind0
\pard\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\pardirnatural\partightenfactor0

\f0\fs24 \cf0 PREFIX owl: <http://www.w3.org/2002/07/owl#>\
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\
PREFIX : <http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#>\
\
SELECT DISTINCT ?probNode ?class ?resolvingNode ?clearState WHERE \{\
    :Hypercholesterolaemia_instance :has_etiology ?entry .\
    ?entry (:System_Event_Logic|:Genetic_Logic|:deviates_into|:swithes_on|:switches_off)* ?probNode .\
    \
    FILTER EXISTS \{?probNode :hasSystemState "Pathological"\}\
    \
    ?probNode rdf:type ?class .\
    FILTER(?class != owl:NamedIndividual)\
    FILTER NOT EXISTS \{\
        ?probNode rdf:type ?subclass .\
        ?subclass rdfs:subClassOf* ?class .\
        Filter(?subclass != ?class)\
    \}\
    FILTER(?class != :Disruption_Type)\
    \
    OPTIONAL \{\
        ?resolvingNode rdf:type ?class .\
        ?resolvingNode :hasSystemState "Pharmacological" .\
        FILTER(?resolvingNode != ?probNode)\
              \
    \}\
    BIND(IF(BOUND(?resolvingNode),"Pharmacologically Resolved","Unresolved")AS ?clearState)\
        \}\
     \
}