{\rtf1\ansi\ansicpg1252\cocoartf2759
\cocoatextscaling0\cocoaplatform0{\fonttbl\f0\fswiss\fcharset0 Helvetica;}
{\colortbl;\red255\green255\blue255;}
{\*\expandedcolortbl;;}
\paperw11900\paperh16840\margl1440\margr1440\vieww11520\viewh8400\viewkind0
\pard\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\tx8640\pardirnatural\partightenfactor0

\f0\fs24 \cf0 PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\
PREFIX : <http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#>\
\
SELECT DISTINCT ?drug ?target ?layer (COUNT(DISTINCT ?downstream)AS ?eliminatedNodes) WHERE\{\
    ?drug rdf:type :Drug_Intervention .\
    ?drug :perturbs_mechanistically ?target .\
    \
    ?target (:System_Event_Logic|:Genetic_Logic|:resolves_to)* ?downstream .\
    \
    ?target rdf:type ?targetClass .\
    ?targetClass rdfs:subClassOf* ?layerClass .\
    \
    VALUES (?layerClass ?layer) \{\
        (:L1_Infrastructure 1)\
        (:Enzyme_Level 1.5)\
        (:Receptor_Level 1.5)\
        (:L2_Hormone_and_biochemical_signalling 2)\
        (:L3_Immune 3)\
        (:L4_Genetic 4)\
    \}\
    \}\
\
GROUPBY ?drug ?target ?layer \
ORDER BY DESC(?eliminatedNodes)}