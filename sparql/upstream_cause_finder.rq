PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX : <http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#>

SELECT (REPLACE(STRAFTER(STR(?upstream),"#"), "_instance", "") AS ?upstreamNode) WHERE {
    ?upstream (:System_Event_Logic|:triggers|:mimics|:deviates_into|:progresses_to)+ :Ischaemia_endocardium_instance
}
