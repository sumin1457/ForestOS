                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Reduced</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasPharmacologicalType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasPharmacologicalType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Drug_Value"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Drug_Intervention"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>EnzymaticBlockade</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>HomeostaticMimicry</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>PhysiologicalHijacking</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasRateState -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasRateState">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#State_Value"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>High</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Low</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>e.g., Heart Rate</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasRegulatoryTone -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasRegulatoryTone">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#State_Value"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Baseline</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Downregulated</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>Upregulated</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasResponseState -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasResponseState">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#State_Value"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Disrupted</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Intact</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment>On the node receiving the sensor&apos;s trigger (e.g., SREBP-2)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasSystemState -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasSystemState">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Value"/>
        <rdfs:range>
            <rdfs:Datatype>
