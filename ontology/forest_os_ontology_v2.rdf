    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Asserted_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Asserted_Logic">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Regulation_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biological_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biological_Logic"/>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Logic">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Drug_Intervention_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Drug_Intervention_Logic"/>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#External_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#External_Logic"/>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Inferred_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Inferred_Logic">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Regulation_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Macro-Clinical_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Macro-Clinical_Logic">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Symptoms_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Symptoms_Logic">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Progression_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Progression_Logic">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biological_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Regulation_Logic -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Regulation_Logic">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biological_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#causes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#causes">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Inferred_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#downregulates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#downregulates">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs_mechanistically"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_complication -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_complication">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Macro-Clinical_Logic"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Conditions"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Conditions"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_etiology -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_etiology">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Macro-Clinical_Logic"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Conditions"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_manifestation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_manifestation">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Macro-Clinical_Logic"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Conditions"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Manifestation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_pathophysiology -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_pathophysiology">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Macro-Clinical_Logic"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Clinical_Conditions"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biomedical_Layer"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_etiology"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#increases"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_etiology"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#inhibits"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_etiology"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#triggers"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_pathophysiology"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#increases"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_pathophysiology"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#inhibits"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#has_pathophysiology"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#targets"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#increases -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#increases">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Asserted_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#inhibits -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#inhibits">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Asserted_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#leads_to -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#leads_to">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Symptoms_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#modulates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#modulates">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Asserted_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Drug_Intervention_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs_functionally -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs_functionally">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs_mechanistically -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs_mechanistically">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#progresses_to -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#progresses_to">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Progression_Logic"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Pathological_State"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Pathological_State"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#promotes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#promotes">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Inferred_Logic"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#promotes"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#increases"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#promotes"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#targets"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#suppresses -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#suppresses">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Inferred_Logic"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#suppresses"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#increases"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#suppresses"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#targets"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#targets -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#targets">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Asserted_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#therapeutic_activation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#therapeutic_activation">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs_functionally"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Drug_Intervention"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biomedical_Layer"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#therapeutic_suppression -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#therapeutic_suppression">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs_functionally"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Drug_Intervention"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biomedical_Layer"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#triggers -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#triggers">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#External_Logic"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#upregulates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#upregulates">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#perturbs_mechanistically"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasConcentrationLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasConcentrationLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Concentration_Dependent_Mediator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasResponsePattern -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasResponsePattern">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biomedical_Layer"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>direct</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>inverse</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#intervenesAtLayerScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#intervenesAtLayerScore">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Drug_Intervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#occursIn -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#occursIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Biomedical_Layer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


