    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#ACE_Inhibitor -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#ACE_Inhibitor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#L2_Mediator_Antagonist"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Acute_Functional_Disruption -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Acute_Functional_Disruption">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Pathological_State"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Adaptive_Immunity -->

    <owl:Class rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#Adaptive_Immunity">
