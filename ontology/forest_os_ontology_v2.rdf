        <downregulates rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#COX1_Platelet_instance"/>
        <therapeutic_suppression rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#BloodClot_physiological_instance"/>
        <rdfs:comment>Aspirin&apos;s COX2/PGI2 suppression is dose-dependent (significant only above ~300mg) — add adverse_effect edge to PGI2 only if/when a dosage or concentration-dependent property is added to the model; asserting it unconditionally at current granularity would misrepresent standard low-dose cardioprotective use.</rdfs:comment>
    </owl:NamedIndividual>
    


