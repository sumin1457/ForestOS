    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#State_Value"/>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Value -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#System_Value"/>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasAccessibilityState -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasAccessibilityState">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#State_Value"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>Exposed</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Sequestered</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasBindingCapacity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasBindingCapacity">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#State_Value"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
