    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasDiscreteState -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasDiscreteState">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#State_Value"/>
