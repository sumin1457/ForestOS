    <rdf:Description rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#m">
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Variable"/>
    </rdf:Description>
