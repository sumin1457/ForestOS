                        <rdf:first>Normal</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>Reduced</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasConcentrationState -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#hasConcentrationState">
