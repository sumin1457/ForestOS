PREFIX : <http://www.semanticweb.org/sumin/ontologies/2026/5/forestos-ontology-3#>
SELECT DISTINCT (Replace(STRAFTER(STR(?drug), "#"), "_instance", "") AS ?MI_drugName) (Replace(STRAFTER(STR(?node), "#"), "_instance", "") AS ?target) WHERE {
    :MI_instance (:has_etiology|:has_pathophysiology) ?entry .
    ?entry(:increases|:inhibits|:modulates|:promotes|:targets|:progresses_to|:leads_to)* ?node .
    ?drug :perturbs_mechanistically ?node 
    }